# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/water_loss_detection?retryWrites=true&w=majority

# Server port (Render sets this automatically, keep 5000 for local dev)
PORT=5000

# ThingSpeak
CHANNEL_ID=your_channel_id_here
READ_API_KEY=your_read_api_key_here

# Gmail SMTP — use a Google App Password, not your account password
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# Generate a random value of at least 32 characters; never reuse a database password.
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
WEB_ORIGINS=http://localhost:5000
RECOVERY_REQUIRED_READINGS=3
RECOVERY_MAX_AGE_MINUTES=5

# Set only for the one-time command: npm run bootstrap-admin
ADMIN_NAME=Initial Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
