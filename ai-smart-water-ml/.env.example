# ============================================================
# AI Smart Water Monitoring ML System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit your .env file to version control.

# --- MongoDB Connection ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=smart_water_db
MONGO_COLLECTION=sensors

# --- Training Data ---
# Path to the Excel training dataset (relative to project root)
TRAINING_FILE=data/training/water_sensor_data.xlsx

# --- Real-Time Monitoring ---
# Interval (in seconds) between each MongoDB check for new records
PREDICTION_INTERVAL_SECONDS=10

# --- Leak Severity Thresholds (probabilities as decimals) ---
SEVERITY_LOW_MAX=0.50
SEVERITY_MEDIUM_MAX=0.80
# Anything >= SEVERITY_MEDIUM_MAX is HIGH

# --- Turbidity / Water Quality Thresholds ---
TURBIDITY_GOOD_MAX=30
TURBIDITY_MODERATE_MAX=60
# Anything > TURBIDITY_MODERATE_MAX is POOR
