# ============================================================
#  Water Loss Detection — Unified Environment Variables
#  Copy this file to .env (at the repo root) and fill in
#  real values.  NEVER commit .env to version control.
# ============================================================

# ── MongoDB ─────────────────────────────────────────────────
# Get this from MongoDB Atlas → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/water_loss_detection?retryWrites=true&w=majority
MONGO_DATABASE=water_loss_detection
MONGO_COLLECTION=sensors

# ── Backend server ───────────────────────────────────────────
# Render sets PORT automatically — keep 5000 for local dev
PORT=5000
NODE_ENV=production

# ── Auth (JWT) ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# ── ThingSpeak (sensor data source) ──────────────────────────
CHANNEL_ID=your_channel_id
READ_API_KEY=your_read_api_key

# ── Email / SMTP (alert notifications) ───────────────────────
# Use a Gmail App Password (16 chars), NOT your account password
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# ── CORS (production) ────────────────────────────────────────
# Set to your deployed frontend URL (same as backend if monorepo)
# For Render: https://your-app-name.onrender.com
WEB_ORIGINS=https://your-app-name.onrender.com

# ── Keep-alive (Render free tier) ────────────────────────────
# Set to your Render service URL so it self-pings every 10 min
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# ── Repair / recovery settings ───────────────────────────────
RECOVERY_REQUIRED_READINGS=3
RECOVERY_MAX_AGE_MINUTES=5

# ── ML pipeline thresholds (optional — defaults shown) ───────
PREDICTION_INTERVAL_SECONDS=10
SEVERITY_LOW_MAX=0.50
SEVERITY_MEDIUM_MAX=0.80
TURBIDITY_GOOD_MAX=30
TURBIDITY_MODERATE_MAX=60

# ── First-run admin bootstrap (used only once) ───────────────
# Run:  cd backend && npm run bootstrap-admin
ADMIN_NAME=Initial Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password_12chars_min
